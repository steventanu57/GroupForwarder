# GroupForwarder settings. Copy this file to .env (in the same folder) and fill in your own values.
# .env is ignored by git, so your settings stay private. Restart the forwarder after a change.

# ---- 1. Your Telegram API login ----
# Get both at https://my.telegram.org/apps: log in with your phone number, open
# "API development tools", create an app (any name works), then copy its api_id (a number)
# and api_hash (a long code). Never share them, or your .session files.
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# ---- 2. Which chats ----
# Chat IDs are numbers. Groups and channels look like -1001234567890 (-100, then digits).
# To see your chats and their IDs:
#   python group_forwarder.py --list-chats   before the forwarder runs
#   /chats in your Saved Messages            while the forwarder runs (/chats crypto: only names with "crypto")
#   python get_groupId.py                    any time (it has its own login)
# A message link in a private group or channel shows it too: t.me/c/1234567890/45 is chat -1001234567890.

# The chats to forward FROM: one or more IDs, separated by commas
SOURCE_GROUP_IDS=-1001111111111,-1002222222222

# The chat to forward TO: one ID, of a group you can post in (usually your own group)
TARGET_GROUP_ID=-1003333333333

# More targets, forum topics, filters and other options: copy forwarder_config.example.toml
# to forwarder_config.toml (see README, "Where to change what").
