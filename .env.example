# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your settings stay private.

# From https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Chats to forward from (comma-separated IDs). Run get_groupId.py to find them.
SOURCE_GROUP_IDS=-1001111111111,-1002222222222

# Your own group that receives the forwarded messages
TARGET_GROUP_ID=-1003333333333
